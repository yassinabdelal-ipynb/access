# Copy this file to .env and put your own keys here. .env is git-ignored.
# Keys stay on this computer: only server.mjs reads them, never the extension.

# Optional: lets Claude plan the redesign, write tile titles and describe pictures.
ANTHROPIC_API_KEY=

# Optional: lets the AI redesign button read the whole site (its hidden menu and main pages) with Apify.
# Create the token in your Apify account settings. Approve the Cheerio Scraper once in Apify Console.
APIFY_TOKEN=

# Optional: the Python used for Head control (needs the packages in requirements.txt).
# Defaults to "python" on Windows. Example: ACCESS_PYTHON=C:\Users\you\miniconda3\envs\access\python.exe
ACCESS_PYTHON=
