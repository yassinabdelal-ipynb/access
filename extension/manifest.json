{
  "manifest_version": 3,
  "name": "Access - your web, your way",
  "version": "0.3.0",
  "description": "Redesigns the page you are on, in place, so it is easier to use. Runs locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
    "default_title": "Redesign this page with Access",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:4173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["access.css", "icons/icon.svg"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
